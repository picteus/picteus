{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "viewkit.json",
    "$defs": {
        "UiContainer": {
            "type": "object",
            "properties": {
                "elements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/UiElement"
                    },
                    "description": "Ordered list of visual elements, structures, and content"
                }
            },
            "required": [
                "elements"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/Envelop"
                }
            ],
            "description": "Container model representing an ordered list of visual elements."
        },
        "UiCard": {
            "type": "object",
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Human-readable feature title displayed in the card header"
                },
                "description": {
                    "type": "string",
                    "description": "Optional neutral subtitle / description for the feature"
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/UiAction"
                    },
                    "description": "Optional card action buttons rendered at the base of the feature card"
                }
            },
            "required": [
                "title"
            ],
            "allOf": [
                {
                    "$ref": "#/$defs/UiContainer"
                }
            ],
            "description": "Root Card container model.\nRepresents a complete feature card rendered inside the 360px panel."
        },
        "UiElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Discriminator property identifying the concrete visual component"
                }
            },
            "required": [
                "type"
            ],
            "oneOf": [
                {
                  "$ref": "#/$defs/StringElement"
                },
                {
                  "$ref": "#/$defs/StringsElement"
                },
                {
                    "$ref": "#/$defs/StringCodeElement"
                },
                {
                    "$ref": "#/$defs/XmlElement"
                },
                {
                    "$ref": "#/$defs/JsonElement"
                },
                {
                    "$ref": "#/$defs/StringUrlElement"
                },
                {
                    "$ref": "#/$defs/IdentifierElement"
                },
                {
                    "$ref": "#/$defs/RatioElement"
                },
                {
                  "$ref": "#/$defs/DimensionsElement"
                },
              {
                    "$ref": "#/$defs/ColourElement"
                },
                {
                    "$ref": "#/$defs/NumberUnboundedElement"
                },
                {
                    "$ref": "#/$defs/NumberBoundedStarsElement"
                },
                {
                    "$ref": "#/$defs/NumberBoundedMeterElement"
                },
                {
                  "$ref": "#/$defs/BooleanElement"
                },
                {
                    "$ref": "#/$defs/TimestampElement"
                },
                {
                    "$ref": "#/$defs/ImageReferenceElement"
                },
                {
                    "$ref": "#/$defs/MarkdownBlockElement"
                },
                {
                    "$ref": "#/$defs/HtmlBlockElement"
                },
                {
                    "$ref": "#/$defs/MultiSlotElement"
                },
                {
                    "$ref": "#/$defs/FlowingElement"
                },
                {
                    "$ref": "#/$defs/LabelValueElement"
                },
                {
                    "$ref": "#/$defs/TableElement"
                },
                {
                    "$ref": "#/$defs/RepeatingGroupElement"
                },
                {
                    "$ref": "#/$defs/CollapsibleGroupElement"
                },
                {
                    "$ref": "#/$defs/DividerElement"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "not": {
                                "enum": [
                                  "string",
                                  "strings",
                                    "string-code",
                                    "xml",
                                    "json",
                                    "string-url",
                                    "identifier",
                                    "ratio",
                                  "dimensions",
                                    "color",
                                    "number-unbounded",
                                    "number-stars",
                                    "number-meter",
                                  "boolean",
                                    "timestamp",
                                    "image-ref",
                                    "markdown",
                                    "html",
                                    "multi-slot",
                                    "flowing",
                                    "label-value",
                                    "table",
                                    "repeating-group",
                                    "collapsible-group",
                                    "divider"
                                ]
                            }
                        }
                    },
                    "required": [
                        "type"
                    ]
                }
            ],
            "description": "Polymorphic root base model for all visual UI elements in Picteus feature views.\nUses the @discriminator(\"type\") decorator so all child models inheriting from UiElement\nare automatically recognized by schema emitters and SDK code generators."
        },
        "Envelop": {
            "type": "object",
            "properties": {
                "schemaVersion": {
                    "type": "string",
                    "const": "1.0",
                    "default": "1.0",
                    "description": "Schema specification version"
                }
            },
            "required": [
                "schemaVersion"
            ],
            "description": "Base envelope container model holding the schema version attribute."
        },
      "StringElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                  "const": "string",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "Text value"
                },
                "representation": {
                  "$ref": "#/$defs/StringRepresentation",
                    "default": "plain",
                    "description": "Display representation mode"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
        "description": "Universal textual string primitive element.\nSupports plain text, compact chip pill, or multiline pre-wrapped presentation."
        },
      "StringsElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                  "const": "strings",
                    "description": "Discriminator type"
                },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Array of string values"
              },
              "representation": {
                "$ref": "#/$defs/StringRepresentation",
                "default": "plain",
                "description": "Display representation mode (plain text or visual chips)"
              },
              "separator": {
                "$ref": "#/$defs/Separator",
                "description": "Optional visual separator rendered between sequential values"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
              "values"
            ],
        "description": "Collection of textual string values rendered as a sequence of inline items or chips.\nSupports visual separators (comma, dot, slash, bar, dash, space) and copyable affordance."
        },
        "StringCodeElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "string-code",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "Text value"
                },
                "language": {
                    "$ref": "#/$defs/CodeLanguage",
                    "description": "Optional syntax highlighting language identifier"
                },
                "modifiers": {
                    "$ref": "#/$defs/BaseModifiers",
                    "description": "Optional visual modifiers (copyable)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Monospace code block or formatted code snippet representation."
        },
        "XmlElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "xml",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "XML content value"
                },
                "modifiers": {
                    "$ref": "#/$defs/BaseModifiers",
                    "description": "Optional visual modifiers (copyable)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "XML markup code block element."
        },
        "JsonElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "json",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "JSON content value"
                },
                "modifiers": {
                    "$ref": "#/$defs/BaseModifiers",
                    "description": "Optional visual modifiers (copyable)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "JSON data or structure representation element."
        },
        "StringUrlElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "string-url",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "Target URL or navigation destination"
                },
                "label": {
                    "type": "string",
                    "description": "Optional custom anchor text label"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Hyperlink representation for external or internal URL navigation."
        },
        "IdentifierElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "identifier",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "Identifier string value"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Monospace semantic identifier representation."
        },
        "RatioElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "ratio",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "Aspect ratio numerical expression"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Aspect ratio representation (e.g. \"16:9\", \"4:3\", \"1:1\")."
        },
      "DimensionsElement": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "dimensions",
            "description": "Discriminator type"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "description": "Width in pixels"
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "description": "Height in pixels"
          },
          "modifiers": {
            "$ref": "#/$defs/BaseModifiers",
            "description": "Optional visual modifiers (copyable)"
          }
        },
        "required": [
          "type",
          "width",
          "height"
        ],
        "description": "Image dimensions representation displaying formatted width and height in pixels."
      },
        "ColourElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "color",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "Hexadecimal color code"
                },
                "label": {
                    "type": "string",
                    "description": "Optional descriptive color name label"
                },
                "showText": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to display the textual color code or label next to the swatch"
                },
                "shape": {
                    "$ref": "#/$defs/Shape",
                    "default": "circle",
                    "description": "Visual shape of the color indicator"
                },
                "size": {
                    "$ref": "#/$defs/Size",
                    "default": "medium",
                    "description": "Visual size of the color indicator"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Single color representation with hex value, shape/size styling, text display toggle, and copy affordance."
        },
        "NumberUnboundedElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "number-unbounded",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "number",
                    "description": "Numeric value"
                },
                "unit": {
                    "type": "string",
                    "description": "Optional unit suffix (e.g. \"px\", \"ms\", \"MB\")"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Plain unbounded numeric value primitive element."
        },
        "NumberBoundedStarsElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "number-stars",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "number",
                    "description": "Numeric rating score"
                },
                "maximum": {
                    "type": "number",
                    "default": 5,
                    "description": "Maximum rating scale (defaults to 5)"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Bounded numeric rating represented as visual stars."
        },
        "NumberBoundedMeterElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "number-meter",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "number",
                    "description": "Numeric value"
                },
                "minimum": {
                    "type": "number",
                    "default": 0,
                    "description": "Minimum scale bound (defaults to 0)"
                },
                "maximum": {
                    "type": "number",
                    "default": 100,
                    "description": "Maximum scale bound (e.g. 100)"
                },
                "label": {
                    "type": "string",
                    "description": "Optional custom text label override (e.g. \"68 / 100\")"
                },
                "unit": {
                    "type": "string",
                    "description": "Optional unit suffix (e.g. \"%\")"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Bounded numeric meter representation (read-only progress / score bar)."
        },
      "BooleanElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                  "const": "boolean",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "boolean",
                    "description": "Boolean state value"
                },
              "representation": {
                "$ref": "#/$defs/BooleanRepresentation",
                "default": "plain",
                "description": "Display representation mode"
                },
                "trueLabel": {
                    "type": "string",
                    "default": "true",
                    "description": "Custom display label when true (defaults to \"true\")"
                },
                "falseLabel": {
                    "type": "string",
                    "default": "false",
                    "description": "Custom display label when false (defaults to \"false\")"
                },
                "variant": {
                    "$ref": "#/$defs/BadgeVariant",
                    "default": "neutral",
                  "description": "Badge color tone when rendered as badge"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
        "description": "Universal boolean primitive element.\nSupports standard plain text or badge pill presentation with customizable labels and variants."
        },
        "TimestampElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "timestamp",
                    "description": "Discriminator type"
                },
                "value": {
                    "type": "string",
                    "description": "The timestamp in milliseconds"
                },
                "format": {
                    "$ref": "#/$defs/TimestampFormat",
                    "default": "datetime",
                    "description": "Presentation date/time format"
                },
                "modifiers": {
                    "$ref": "#/$defs/PrimitiveModifiers",
                    "description": "Optional visual modifiers (copyable, truncate, emphasis, monospace)"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "description": "Formatted date and time representation."
        },
        "ImageReferenceElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "image-ref",
                    "description": "Discriminator type"
                },
                "src": {
                    "type": "string",
                    "description": "Image source URI (HTTPS URL, base64 data URI, or asset path)"
                },
                "alt": {
                    "type": "string",
                    "description": "Accessible alternative description"
                },
                "aspectRatio": {
                    "type": "string",
                    "default": "1:1",
                    "description": "Aspect ratio of the thumbnail container"
                },
                "placeholder": {
                    "type": "string",
                    "description": "Fallback placeholder image URI"
                }
            },
            "required": [
                "type",
                "src"
            ],
            "description": "Thumbnail image reference with placeholder fallback handling."
        },
        "MarkdownBlockElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "markdown",
                    "description": "Discriminator type"
                },
                "content": {
                    "type": "string",
                    "description": "Raw Markdown markup content"
                },
                "modifiers": {
                    "$ref": "#/$defs/BaseModifiers",
                    "description": "Optional visual modifiers (copyable)"
                }
            },
            "required": [
                "type",
                "content"
            ],
            "description": "Full Markdown fallback block rendered with core typographic hierarchy, spacing, and styling."
        },
        "HtmlBlockElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "html",
                    "description": "Discriminator type"
                },
                "content": {
                    "type": "string",
                    "description": "Raw HTML markup content"
                },
                "modifiers": {
                    "$ref": "#/$defs/BaseModifiers",
                    "description": "Optional visual modifiers (copyable)"
                }
            },
            "required": [
                "type",
                "content"
            ],
            "description": "Sandboxed HTML rendering escape hatch."
        },
        "MultiSlotElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "multi-slot",
                    "description": "Discriminator type"
                },
                "slots": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Slot"
                    },
                    "description": "List of slots comprising the row"
                }
            },
            "required": [
                "type",
                "slots"
            ],
          "description": "Multi-slot horizontal row layout comprising slots with individual widths."
        },
        "FlowingElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "flowing",
                    "description": "Discriminator type"
                },
              "separator": {
                "$ref": "#/$defs/Separator",
                "description": "Optional visual separator rendered between sequential child elements"
              },
                "elements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/UiElement"
                    },
                    "description": "List of child elements rendered sequentially with line wrapping"
                }
            },
            "required": [
                "type",
                "elements"
            ],
            "description": "Flowing inline layout container with automatic line wrapping.\nRenders child elements horizontally in sequence, automatically wrapping to the next line when space runs out."
        },
        "LabelValueElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "label-value",
                    "description": "Discriminator type"
                },
                "label": {
                    "type": "string",
                    "description": "Key or descriptive label displayed muted on the left"
                },
                "value": {
                    "description": "Rendered value element on the right",
                    "$ref": "#/$defs/UiElement"
                },
                "withDivider": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to render a bottom border/hairline divider"
                }
            },
            "required": [
                "type",
                "label",
                "value"
            ],
            "description": "Standard label and value row.\nDisplays a muted label on the left and value representation on the right with a vertical dividing line."
        },
        "TableElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "table",
                    "description": "Discriminator type"
                },
                "isStriped": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to render alternating row background colors"
                },
                "withColumnSeparators": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to render vertical column separators"
                },
                "withRowSeparators": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to render horizontal row separators"
                },
                "columns": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TableColumn"
                    },
                    "description": "Optional explicit column definitions"
                },
                "rows": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/TableRow"
                    },
                    "description": "Tabular data rows"
                }
            },
            "required": [
                "type",
                "rows"
            ],
            "description": "Structured tabular data representation.\nSupports header/borderless modes, 2-column key-value tables, and 3-column data tables."
        },
        "RepeatingGroupElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "repeating-group",
                    "description": "Discriminator type"
                },
                "title": {
                    "type": "string",
                    "description": "Optional section header for the group"
                },
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/RepeatingGroupEntry"
                    },
                    "description": "List of repeated entry records"
                }
            },
            "required": [
                "type",
                "entries"
            ],
            "description": "Repeating group container where entries share uniform structure and retain per-entry labels."
        },
        "CollapsibleGroupElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "collapsible-group",
                    "description": "Discriminator type"
                },
                "title": {
                    "type": "string",
                    "description": "Group title (e.g. \"Show specimen details\")"
                },
                "summary": {
                    "type": "string",
                    "description": "Secondary summary indicator (e.g. \"2 neutral values\")"
                },
                "defaultExpanded": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether the disclosure is open/expanded by default"
                },
                "elements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/UiElement"
                    },
                    "description": "Nested content elements revealed when expanded"
                }
            },
            "required": [
                "type",
                "title",
                "elements"
            ],
            "description": "Collapsible disclosure container (accordion) with summary badge."
        },
        "DividerElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "divider",
                    "description": "Discriminator type"
                },
                "style": {
                    "$ref": "#/$defs/DividerStyle",
                    "default": "hairline",
                    "description": "Line styling"
                }
            },
            "required": [
                "type"
            ],
            "description": "Visual hairline separator separating sections or element groups."
        },
      "StringRepresentation": {
            "type": "string",
            "enum": [
                "plain",
              "chip",
              "multiline"
            ],
        "description": "Visual presentation style for string values."
        },
        "PrimitiveModifiers": {
            "type": "object",
            "properties": {
                "truncate": {
                    "$ref": "#/$defs/TruncateOptions",
                    "description": "Configures character truncation threshold with show-more affordance"
                },
                "weight": {
                    "$ref": "#/$defs/TextWeight",
                    "default": "normal",
                    "description": "Typographic text weight"
                },
                "intensity": {
                    "$ref": "#/$defs/TextIntensity",
                    "default": "medium",
                    "description": "Visual text color intensity"
                },
                "monospace": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to use monospace font rendering (for hashes, IDs, codes)"
                }
            },
            "allOf": [
                {
                    "$ref": "#/$defs/BaseModifiers"
                }
            ],
            "description": "Common modifier traits that can be attached to primitive elements."
        },
      "Separator": {
        "type": "string",
        "enum": [
          "bar",
          "comma",
          "dot",
          "slash",
          "dash",
          "space"
        ],
        "description": "Visual separator rendered between sequential elements or items."
      },
        "CodeLanguage": {
            "type": "string",
            "enum": [
                "xml",
                "json",
                "yaml"
            ],
            "description": "Supported syntax highlighting languages for formatted code blocks."
        },
        "BaseModifiers": {
            "type": "object",
            "properties": {
                "copyable": {
                    "type": "boolean",
                    "description": "Adds an interactive copy button/action next to the rendered value"
                }
            },
            "description": "Base modifier traits for elements that support copy affordance."
        },
        "Shape": {
            "type": "string",
            "enum": [
                "circle",
                "square"
            ],
            "description": "Geometric shape representation for visual containers and indicators."
        },
        "Size": {
            "type": "string",
            "enum": [
                "small",
                "medium",
                "large"
            ],
            "description": "Relative sizing scale for visual elements and indicators."
        },
      "BooleanRepresentation": {
        "type": "string",
        "enum": [
          "plain",
          "badge"
        ],
        "description": "Visual presentation style for boolean values."
      },
        "BadgeVariant": {
            "type": "string",
            "enum": [
                "neutral",
                "success",
                "warning",
                "danger"
            ],
            "description": "Visual color tone variants for badge pill representations."
        },
        "TimestampFormat": {
            "type": "string",
            "enum": [
                "datetime",
                "date",
                "time",
                "relative"
            ],
            "description": "Presentation format styles for timestamp elements."
        },
        "Slot": {
            "type": "object",
            "properties": {
                "label": {
                    "type": "string",
                    "description": "Optional slot label (e.g. \"Slot A\")"
                },
                "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "description": "Width percentage (1-100)"
                },
                "content": {
                    "description": "Rendered content inside the slot",
                    "$ref": "#/$defs/UiElement"
                }
            },
            "required": [
                "content"
            ],
            "description": "Single slot within a multi-slot horizontal row layout."
        },
        "TableColumn": {
            "type": "object",
            "properties": {
                "header": {
                    "type": "string",
                    "description": "Display header text"
                },
                "align": {
                    "$ref": "#/$defs/TableColumnAlign",
                    "default": "left",
                    "description": "Text horizontal alignment"
                },
                "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "description": "Width percentage (1-100)"
                },
                "widthMode": {
                    "$ref": "#/$defs/TableColumnWidthMode",
                    "default": "fixed",
                    "description": "Sizing mode for the provided width"
                }
            },
            "description": "Column definition for structured tables."
        },
        "TableRow": {
            "type": "object",
            "properties": {
                "cells": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/UiElement"
                    },
                    "description": "Array of cell values corresponding to table columns"
                }
            },
            "required": [
                "cells"
            ],
            "description": "Single table row containing an array of cell values."
        },
        "RepeatingGroupEntry": {
            "type": "object",
            "properties": {
                "label": {
                    "type": "string",
                    "description": "Entry label"
                },
                "value": {
                    "description": "Primary entry value or nested elements",
                    "$ref": "#/$defs/UiElement"
                },
                "elements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/UiElement"
                    },
                    "description": "Nested elements for structured entries"
                }
            },
            "required": [
                "label"
            ],
            "description": "Single entry within a repeating group."
        },
        "DividerStyle": {
            "type": "string",
            "enum": [
                "hairline",
                "solid",
                "dashed"
            ],
            "description": "Visual styling variants for hairline dividers."
        },
        "TruncateOptions": {
            "type": "object",
            "properties": {
                "characterLimit": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647,
                    "description": "Maximum number of characters to display before truncating"
                },
                "showMore": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to render a \"Show more\" / \"Show less\" toggle affordance"
                }
            },
            "required": [
                "characterLimit"
            ],
            "description": "Truncation configuration for long textual content with optional expand affordance."
        },
        "TextWeight": {
            "type": "string",
            "enum": [
                "thin",
                "normal",
                "heavy"
            ],
            "description": "Typographic stroke weight styling."
        },
        "TextIntensity": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high"
            ],
            "description": "Visual text color intensity and contrast."
        },
        "TableColumnAlign": {
            "type": "string",
            "enum": [
                "left",
                "center",
                "right"
            ],
            "description": "Text horizontal alignment options for table columns."
        },
        "TableColumnWidthMode": {
            "type": "string",
            "enum": [
                "fixed",
                "maximum"
            ],
            "description": "Width mode for table columns."
        },
        "UiAction": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Discriminator property"
                },
                "label": {
                    "type": "string",
                    "description": "Display label for the action"
                }
            },
            "required": [
                "type",
                "label"
            ],
            "oneOf": [
                {
                    "$ref": "#/$defs/ButtonActionElement"
                },
                {
                    "$ref": "#/$defs/ExternalLinkActionElement"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "not": {
                                "enum": [
                                    "button",
                                    "external-link"
                                ]
                            }
                        },
                        "label": {
                            "type": "string",
                            "description": "Display label for the action"
                        }
                    },
                    "required": [
                        "type",
                        "label"
                    ]
                }
            ],
            "description": "Polymorphic base model for interactive actions."
        },
        "ButtonActionElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "button",
                    "description": "Discriminator type"
                },
                "label": {
                    "type": "string",
                    "description": "Display label for the action"
                },
                "extensionId": {
                    "type": "string",
                    "description": "Extension identifier owning the target command"
                },
                "commandId": {
                    "type": "string",
                    "description": "Command identifier to invoke"
                },
                "target": {
                    "type": "string",
                    "description": "Target entity or context identifier"
                },
                "parameters": {
                    "$ref": "#/$defs/RecordUnknown",
                    "description": "Optional arbitrary parameters payload forwarded to the command handler"
                },
                "disabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether the button is disabled / unavailable"
                },
                "variant": {
                    "$ref": "#/$defs/ButtonVariant",
                    "default": "secondary",
                    "description": "Button visual style variant"
                }
            },
            "required": [
                "type",
                "label",
                "commandId"
            ],
            "description": "Interactive button action triggering an extension command."
        },
        "ExternalLinkActionElement": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "external-link",
                    "description": "Discriminator type"
                },
                "label": {
                    "type": "string",
                    "description": "Display label for the action"
                },
                "url": {
                    "type": "string",
                    "description": "Target URL destination"
                }
            },
            "required": [
                "type",
                "label",
                "url"
            ],
            "description": "External link action distinct from inline URL text values."
        },
        "RecordUnknown": {
            "type": "object",
            "properties": {},
            "unevaluatedProperties": {}
        },
        "ButtonVariant": {
            "type": "string",
            "enum": [
                "primary",
                "secondary",
                "subtle",
                "danger"
            ],
            "description": "Visual style variants for interactive button actions."
        }
    }
}
