{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v2.schema.json",
  "id": "comfyui",
  "version": "0.5.0",
  "name": "ComfyUI",
  "description": "Interacts with ComfyUI.",
  "categories": [
    "capture",
    "enrichment",
    "generation"
  ],
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "events": [
        "process.started",
        "image.created",
        "image.updated",
        "image.computeTags",
        "image.computeFeatures",
        "image.runCommand"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.created",
            "image.updated",
            "image.computeTags",
            "image.computeFeatures"
          ],
          "maximumCount": 10
        }
      ],
      "capabilities": [
        {
          "id": "image.tags"
        },
        {
          "id": "image.features"
        }
      ],
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/back-end/main.js"
        ]
      },
      "commands": [
        {
          "id": "openInComfyUi",
          "on": {
            "entity": "Image",
            "withTags": [
              "comfyui"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Edit",
              "name": "Edit ComfyUI workflow",
              "description": "Loads in the ComfyUI instance the workflow that has been used to generate the image."
            }
          ]
        }
      ]
    }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "format": "uri",
        "title": "URL",
        "description": "The URL of the ComfyUI interface.",
        "default": "http://127.0.0.1:8188"
      },
      "directoryPath": {
        "type": "string",
        "title": "Directory path",
        "description": "The path of the root directory where ComfyUI is installed.",
        "ui": {
          "widget": "directory"
        }
      },
      "extractLoRAsAndAdapters": {
        "type": "boolean",
        "title": "Extract LoRAs and adapters",
        "description": "Extract LoRA models, ControlNets, and IP-Adapters into the UI card.",
        "default": true
      },
      "extractUpscalingAndRefinement": {
        "type": "boolean",
        "title": "Extract upscaling and refinement",
        "description": "Extract upscale models, refiners, and detailers into the UI card.",
        "default": true
      },
      "extractWorkflowTopology": {
        "type": "boolean",
        "title": "Extract workflow topology",
        "description": "Extract node category breakdown, workflow groups, and node statistics into the UI card.",
        "default": true
      }
    },
    "required": [
      "url",
      "directoryPath"
    ]
  },
  "ui": {
    "elements": [
      {
        "id": "main",
        "integration": {
          "anchor": "sidebar",
          "isExternal": false
        },
        "url": "/dist/front-end/index.html"
      }
    ]
  }
}
