{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v6.schema.json",
  "id": "example-python",
  "version": "1.9.0",
  "name": "Python Example",
  "description": "An example of a Python extension.",
  "categories": [
    "enrichment",
    "utility"
  ],
  "author": "KoppaSoft",
  "runtimes": [
    {
      "environment": "python"
    }
  ],
  "instructions": [
    {
      "execution": {
        "executable": "${venvPython}",
        "arguments": [
          "./main.py"
        ]
      },
      "events": [
        "process.started",
        "process.runCommand",
        "image.created",
        "image.updated",
        "image.tags.updated",
        "image.features.updated",
        "image.embeddings.updated",
        "image.deleted",
        "image.computeTags",
        "image.computeFeatures",
        "image.runCommand"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.created",
            "image.updated",
            "image.tags.updated",
            "image.features.updated",
            "image.embeddings.updated",
            "image.deleted",
            "image.computeTags",
            "image.computeFeatures"
          ],
          "durationInMilliseconds": 50,
          "maximumCount": 20
        }
      ],
      "capabilities": [
        {
          "id": "image.tags"
        },
        {
          "id": "image.features"
        }
      ],
      "commands": [
        {
          "id": "logDimensions",
          "on": {
            "entity": "Images"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Log",
              "name": "Logs the image dimensions",
              "description": "Reads the provided images and logs their dimensions in the application."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/logs.svg"
          }
        },
        {
          "id": "convert",
          "on": {
            "entity": "Images"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "title": "Format",
                "description": "What is the format of the image?",
                "enum": [
                  "jpeg",
                  "png",
                  "webp"
                ],
                "default": "jpeg",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "stripMetadata": {
                "type": "boolean",
                "title": "Strip metadata?",
                "description": "Whether the metadata should be stripped from the converted images",
                "default": true
              },
              "width": {
                "type": "integer",
                "title": "Width",
                "description": "The width of the converted image in pixels. If not set, the original width is kept.",
                "minimum": 1,
                "ui": {
                  "widget": "updown"
                }
              },
              "height": {
                "type": "integer",
                "title": "Height",
                "description": "The height of the converted image in pixels. If not set, the original height is kept.",
                "minimum": 1,
                "ui": {
                  "widget": "updown"
                }
              },
              "resizeRender": {
                "type": "string",
                "title": "Resize Render",
                "description": "If the 'width' or 'height' parameter is provided, whether the final image dimensions should be within the box defined by those parameters.",
                "enum": [
                  "inbox",
                  "outbox"
                ],
                "default": "inbox",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              }
            },
            "required": [
              "format",
              "stripMetadata"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Convert",
              "name": "Converts an image",
              "description": "Given a format, converts the provided images into the desired format and stores them in the same repository."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/convert.svg"
          }
        },
        {
          "id": "form",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "creatorName": {
                "type": "string",
                "title": "Creator name",
                "description": "What is your creator or artist name?",
                "default": "Ada Lovelace"
              },
              "creativeRole": {
                "type": "string",
                "title": "Creative role",
                "description": "Choose your primary creative persona.",
                "enum": [
                  "Cyberpunk Artist",
                  "Space Explorer",
                  "Fantasy Alchemist"
                ],
                "default": "Cyberpunk Artist",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "experienceLevel": {
                "type": "integer",
                "title": "Experience level",
                "description": "Your creative proficiency level (1-100).",
                "minimum": 1,
                "maximum": 100,
                "default": 42,
                "ui": {
                  "widget": "range"
                }
              },
              "passcode": {
                "type": "string",
                "title": "Studio passcode",
                "description": "A secret passphrase to lock your session.",
                "default": "my-secret",
                "ui": {
                  "widget": "password"
                }
              },
              "startDate": {
                "type": "string",
                "title": "Start date",
                "description": "When did your creative journey begin?",
                "format": "date",
                "default": "2023-05-04"
              },
              "heroImageId": {
                "type": "string",
                "title": "Hero image",
                "description": "Select the primary hero image for this project.",
                "ui": {
                  "widget": "image"
                }
              },
              "referenceImageIds": {
                "type": "array",
                "title": "Reference images",
                "description": "Select one or more inspiration images from your library.",
                "items": {
                  "type": "string"
                },
                "default": [],
                "ui": {
                  "widget": "image"
                }
              },
              "sourceCollectionId": {
                "type": "number",
                "title": "Source collection",
                "description": "Which collection would you like to use as a source?",
                "ui": {
                  "widget": "collection"
                }
              },
              "targetRepositoryId": {
                "type": "string",
                "title": "Target repository",
                "description": "Which repository would you like to use for outputs?",
                "ui": {
                  "widget": "repository"
                }
              }
            },
            "required": [
              "creatorName",
              "creativeRole"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Form",
              "name": "Dynamic Form",
              "description": "Demonstrates the dynamic form grammar."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/form.svg"
          }
        },
        {
          "id": "dialog",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "title": "Type",
                "description": "What kind of dialog box do you want to open?",
                "enum": [
                  "Simple",
                  "With HTML"
                ],
                "default": "Simple",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Dialog",
              "name": "Open a dialog",
              "description": "Opens a question dialog box to the user."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/dialog.svg"
          }
        },
        {
          "id": "ui",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "anchor": {
                "type": "string",
                "title": "Integration",
                "description": "What kind of UI do you want to open?",
                "enum": [
                  "Modal",
                  "Sidebar",
                  "SidebarExternal",
                  "Window",
                  "Tab"
                ],
                "default": "Modal",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "nature": {
                "type": "string",
                "title": "Nature",
                "description": "What nature of content do you want to open?",
                "enum": [
                  "URL",
                  "HTML"
                ],
                "default": "URL",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              }
            },
            "required": [
              "anchor",
              "nature"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "UI",
              "name": "Open a UI",
              "description": "Opens a specific UI, after having asked which one."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/ui.svg"
          }
        },
        {
          "id": "openBrowser",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "title": "URL",
                "description": "What is the URL to open in the browser?",
                "default": "https://github.com/picteus/picteus"
              }
            },
            "required": [
              "url"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Browser",
              "name": "Open URL in browser",
              "description": "Opens the browser at specific URL, after having asked which one."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/browser.svg"
          }
        },
        {
          "id": "show",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "title": "Type",
                "description": "What do you want to show?",
                "enum": [
                  "sidebar",
                  "extensionSettings",
                  "image",
                  "repository"
                ],
                "default": "sidebar"
              }
            },
            "required": [
              "type"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Show",
              "name": "Show item",
              "description": "Asks the user for options to show a specific item."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/show.svg"
          }
        },
        {
          "id": "readFile",
          "on": {
            "entity": "Process"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Read",
              "name": "Reads a file",
              "description": "Asks the user to pick a file and accesses to its content."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/readFile.svg"
          }
        },
        {
          "id": "writeFile",
          "on": {
            "entity": "Process"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Write",
              "name": "Writes a file",
              "description": "Asks the user to pick a file for saving some content."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/writeFile.svg"
          }
        },
        {
          "id": "toast",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "title": "Type",
                "description": "The toast type.",
                "enum": [
                  "info",
                  "cancel",
                  "error"
                ],
                "default": "info"
              },
              "title": {
                "type": "string",
                "title": "Title",
                "description": "The toast title.",
                "default": "My Toast"
              },
              "subtitle": {
                "type": "string",
                "title": "Subtitle",
                "description": "The toast subtitle.",
                "default": "My subtitle"
              }
            },
            "required": [
              "type",
              "title",
              "subtitle"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Toast",
              "name": "Trigger toast",
              "description": "Triggers a toast based on the user inputs."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/toast.svg"
          }
        },
        {
          "id": "notification",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "title": "Title",
                "description": "The notification title.",
                "default": "My Notification"
              },
              "subtitle": {
                "type": "string",
                "title": "Subtitle",
                "description": "The notification subtitle.",
                "default": "My subtitle"
              },
              "body": {
                "type": "string",
                "title": "Body",
                "description": "The notification body",
                "default": "This is the notification body."
              },
              "isNative": {
                "type": "boolean",
                "title": "Is native?",
                "description": "Should the notification be displayed through the OS native system?",
                "default": true
              }
            },
            "required": [
              "title",
              "subtitle",
              "body",
              "isNative"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Notification",
              "name": "Trigger notification",
              "description": "Triggers a notification based on the user inputs."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/notification.svg"
          }
        },
        {
          "id": "action",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "title": "Intent",
                "description": "The intent to trigger when the user clicks on the notification.",
                "enum": [
                  "show",
                  "ui",
                  "openBrowser",
                  "command"
                ],
                "default": "ui"
              }
            },
            "required": [
              "intent"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Action",
              "name": "Trigger action",
              "description": "Triggers an action, which displays a notification and then runs a process."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/action.svg"
          }
        },
        {
          "id": "application",
          "on": {
            "entity": "Process"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Application",
              "name": "Open application",
              "description": "Opens an application in a dialog box."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/application.svg"
          }
        }
      ]
    }
  ],
  "ui": {
    "elements": [
      {
        "id": "main",
        "integration": {
          "anchor": "sidebar",
          "isExternal": false
        },
        "url": "/ui/sidebar/index.html"
      }
    ]
  },
  "settings": {
    "type": "object",
    "properties": {
      "simpleString": {
        "type": "string",
        "title": "Simple string",
        "description": "A string parameter with a default value and represented with a text area.",
        "default": "This is a text inside a textarea.",
        "ui": {
          "widget": "textarea"
        }
      },
      "simpleInteger": {
        "type": "integer",
        "title": "Simple integer",
        "description": "An integer parameter with a default value and bounds.",
        "minimum": 1,
        "maximum": 100,
        "default": 50,
        "ui": {
          "widget": "updown"
        }
      },
      "simpleFloat": {
        "type": "number",
        "title": "Simple float",
        "description": "A floating number parameter with a default value and bounds.",
        "minimum": 1,
        "maximum": 100,
        "default": 3.14,
        "ui": {
          "widget": "range"
        }
      },
      "simpleBoolean": {
        "type": "boolean",
        "title": "Simple boolean",
        "description": "A boolean parameter with a default value.",
        "default": true
      },
      "enumerated": {
        "type": "string",
        "title": "Enumerated",
        "description": "A string parameter with limited values.",
        "enum": [
          "value A",
          "value B",
          "value C",
          "value D",
          "value E"
        ],
        "default": "value C",
        "ui": {
          "widget": "radio",
          "inline": true
        }
      },
      "complexObject": {
        "type": "object",
        "title": "Complex object",
        "description": "An object which has properties.",
        "properties": {
          "property1": {
            "type": "boolean",
            "title": "Property 1",
            "description": "A first nested property.",
            "default": false
          },
          "property2": {
            "type": "string",
            "title": "Property 2",
            "description": "A second nested property.",
            "default": "My value"
          }
        },
        "required": []
      }
    },
    "required": [
      "simpleString",
      "enumerated"
    ]
  }
}
