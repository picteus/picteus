{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v5.schema.json",
  "id": "civitai",
  "version": "1.8.0",
  "name": "Civitai",
  "description": "Interacts with Civitai images.",
  "categories": [
    "capture"
  ],
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "events": [
        "process.started",
        "process.runCommand",
        "image.runCommand"
      ],
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/main.js"
        ]
      },
      "commands": [
        {
          "id": "fetchImages",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "description": "The source of data: a user, post, or single image.",
                "oneOf": [
                  {
                    "title": "User",
                    "properties": {
                      "userName": {
                        "type": "string",
                        "title": "User",
                        "description": "The identifier of the Civitai user",
                        "minLength": 1,
                        "maxLength": 64,
                        "default": "Lady_Luminous"
                      }
                    },
                    "required": [
                      "userName"
                    ]
                  },
                  {
                    "title": "Post",
                    "properties": {
                      "postId": {
                        "type": "string",
                        "title": "Post id",
                        "description": "The identifier of the Civitai post",
                        "minLength": 1,
                        "maxLength": 64,
                        "default": "31043666"
                      }
                    },
                    "required": [
                      "postId"
                    ]
                  },
                  {
                    "title": "Image",
                    "properties": {
                      "imageId": {
                        "type": "integer",
                        "title": "Image id",
                        "description": "The identifier of the Civitai image",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "imageId"
                    ]
                  }
                ]
              },
              "count": {
                "type": "integer",
                "title": "Count",
                "description": "The number of images to fetch for a user or post source. This is ignored for a single image source.",
                "minimum": 1,
                "maximum": 100,
                "default": 10
              },
              "onlyWithMetadata": {
                "type": "boolean",
                "title": "Only with metadata",
                "description": "Whether to fetch only images that include generation metadata. When enabled for a single image source, the image is skipped if it has no metadata.",
                "default": true
              }
            },
            "required": [
              "source",
              "count",
              "onlyWithMetadata"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Fetch",
              "name": "Fetch images",
              "description": "Fetches images for a Civitai user or post, or fetches one image by its Civitai image identifier, and stores them with their metadata and source in the extension's repository."
            }
          ]
        }
      ]
    }
  ],
  "ui": {
    "elements": [
      {
        "id": "main",
        "integration": {
          "anchor": "sidebar",
          "isExternal": true
        },
        "url": "https://civitai.com"
      }
    ]
  },
  "settings": {
    "type": "object"
  }
}
