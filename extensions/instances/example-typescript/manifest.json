{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v2.schema.json",
  "id": "example-typescript",
  "version": "1.2.0",
  "name": "TypeScript example",
  "description": "An example of a TypeScript extension.",
  "categories": ["enrichment", "utility"],
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/main.js"
        ]
      },
      "events": [
        "process.started",
        "process.runCommand",
        "image.created",
        "image.updated",
        "image.tags.updated",
        "image.features.updated",
        "image.deleted",
        "image.computeTags",
        "image.computeFeatures",
        "image.runCommand"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.created",
            "image.updated",
            "image.tags.updated",
            "image.features.updated",
            "image.deleted",
            "image.computeTags",
            "image.computeFeatures"
          ],
          "durationInMilliseconds": 50,
          "maximumCount": 20
        }
      ],
      "capabilities": [
        {
          "id": "image.tags"
        },
        {
          "id": "image.features"
        }
      ],
      "commands": [
        {
          "id": "logDimensions",
          "on": {
            "entity": "Images"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Log",
              "name": "Logs the image dimensions",
              "description": "Reads the provided images and logs their dimensions in the application."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/logs.svg"
          }
        },
        {
          "id": "convert",
          "on": {
            "entity": "Images"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "title": "Format",
                "description": "What is the format of the image?",
                "enum": [
                  "jpeg",
                  "png",
                  "webp"
                ],
                "default": "jpeg",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "stripMetadata": {
                "type": "boolean",
                "title": "Strip metadata?",
                "description": "Whether the metadata should be stripped from the converted images",
                "default": true
              },
              "width": {
                "type": "integer",
                "title": "Width",
                "description": "The width of the converted image in pixels. If not set, the original width is kept.",
                "minimum": 1,
                "ui": {
                  "widget": "updown"
                }
              },
              "height": {
                "type": "integer",
                "title": "Height",
                "description": "The height of the converted image in pixels. If not set, the original height is kept.",
                "minimum": 1,
                "ui": {
                  "widget": "updown"
                }
              },
              "resizeRender": {
                "type": "string",
                "title": "Resize Render",
                "description": "If the 'width' or 'height' parameter is provided, whether the final image dimensions should be within the box defined by those parameters.",
                "enum": [
                  "inbox",
                  "outbox"
                ],
                "default": "inbox",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              }
            },
            "required": [
              "format",
              "stripMetadata"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Convert",
              "name": "Converts an image",
              "description": "Given a format, converts the provided images into the desired format and stores them in the same repository."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/convert.svg"
          }
        },
        {
          "id": "askForSomething",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "age": {
                "type": "integer",
                "title": "Age",
                "description": "What is your age?",
                "minimum": 1,
                "maximum": 128,
                "default": 35,
                "ui": {
                  "widget": "range"
                }
              }
            },
            "required": [
              "age"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Ask",
              "name": "Ask something",
              "description": "Asks questions to the user and if the answer on whether she likes chocolate, opens a modal on a website."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/askForSomething.svg"
          }
        },
        {
          "id": "dialog",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "title": "Type",
                "description": "What kind of dialog box do you want to open?",
                "enum": [
                  "Simple",
                  "With HTML"
                ],
                "default": "Simple",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              }
            },
            "required": [
              "type"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Dialog",
              "name": "Open a dialog",
              "description": "Opens a question dialog box to the user."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/dialog.svg"
          }
        },
        {
          "id": "ui",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "anchor": {
                "type": "string",
                "title": "Integration",
                "description": "What kind of UI do you want to open?",
                "enum": [
                  "Modal",
                  "Sidebar",
                  "SidebarExternal",
                  "Window"
                ],
                "default": "Modal",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "nature": {
                "type": "string",
                "title": "Nature",
                "description": "What nature of content do you want to open?",
                "enum": [
                  "URL",
                  "HTML"
                ],
                "default": "URL",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              }
            },
            "required": [
              "anchor",
              "nature"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "UI",
              "name": "Open a UI",
              "description": "Opens a specific UI, after having asked which one."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/ui.svg"
          }
        },
        {
          "id": "show",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "title": "Type",
                "description": "What do you want to show?",
                "enum": [
                  "sidebar",
                  "extensionSettings",
                  "image",
                  "repository"
                ],
                "default": "sidebar"
              }
            },
            "required": [
              "type"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Show",
              "name": "Show item",
              "description": "Asks the user for options to show a specific item."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/show.svg"
          }
        },
        {
          "id": "readFile",
          "on": {
            "entity": "Process"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Read",
              "name": "Reads a file",
              "description": "Asks the user to pick a file and accesses to its content."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/readFile.svg"
          }
        },
        {
          "id": "writeFile",
          "on": {
            "entity": "Process"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Write",
              "name": "Writes a file",
              "description": "Asks the user to pick a file for saving some content."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/writeFile.svg"
          }
        },
        {
          "id": "notification",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "title": "Title",
                "description": "The notification title.",
                "default": "My Title"
              },
              "subtitle": {
                "type": "string",
                "title": "Subtitle",
                "description": "The notification subtitle.",
                "default": "My subtitle"
              },
              "body": {
                "type": "string",
                "title": "Body",
                "description": "The notification body",
                "default": "This is the notification body."
              },
              "isNative": {
                "type": "boolean",
                "title": "Is native?",
                "description": "Should the notification be displayed through the OS native system?",
                "default": true
              }
            },
            "required": [
              "title",
              "subtitle",
              "body",
              "isNative"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Notification",
              "name": "Trigger notification",
              "description": "Triggers a notification based on the user inputs."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/notification.svg"
          }
        },
        {
          "id": "action",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string",
                "title": "Intent",
                "description": "The intent to trigger when the user clicks on the notification.",
                "enum": [
                  "ui",
                  "show",
                  "command"
                ],
                "default": "ui"
              }
            },
            "required": [
              "intent"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Action",
              "name": "Trigger action",
              "description": "Triggers an action, which displays a notification and then runs a process."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/action.svg"
          }
        },
        {
          "id": "application",
          "on": {
            "entity": "Process"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Application",
              "name": "Open application",
              "description": "Opens an application in a dialog box."
            }
          ],
          "ui": {
            "iconUri": "/ui/icons/application.svg"
          }
        }
      ]
    }
  ],
  "ui": {
    "elements": [
      {
        "id": "main",
        "integration": {
          "anchor": "sidebar",
          "isExternal": false
        },
        "url": "/ui/sidebar/index.html"
      }
    ]
  },
  "settings": {
    "type": "object",
    "properties": {
      "parameter": {
        "type": "string",
        "title": "Parameter",
        "description": "A parameter which enables to tune the extension.",
        "ui": {
          "widget": "textarea"
        }
      }
    },
    "required": [
      "parameter"
    ]
  }
}
