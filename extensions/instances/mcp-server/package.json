{
  "name": "@picteus/mcp-server",
  "version": "1.2.0",
  "productName": "Picteus MCP Server",
  "description": "Exposes a MCP server over the Picteus API.",
  "keywords": [
    "picteus",
    "extension",
    "mcp",
    "server",
    "ia"
  ],
  "author": {
    "name": "Édouard Mercier",
    "email": "edouard@koppasoft.com",
    "url": "https://github.com/edouardmercier"
  },
  "license": "GNU Affero General Public License",
  "private": false,
  "engines": {
    "node": ">=22.17.1"
  },
  "homepage": "https://github.com/picteus/Picteus",
  "repository": {
    "type": "git",
    "url": "https://github.com/picteus/Picteus.git"
  },
  "bugs": {
    "url": "https://github.com/picteus/Picteus/issues"
  },
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist",
    "manifest.json",
    "icon.png"
  ],
  "scripts": {
    "mcp:generate": "openapi-mcp-generator --input ../../../back-end/openapi.json --output ./generated --server-name \"picteus-mcp-server\" --transport web --force  --generate-lib",
    "compile": "tsc",
    "build": "npm run compile"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "22.17.1",
    "openapi-mcp-generator": "4.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "1.18.1",
    "dotenv": "17.4.2",
    "zod": "3.25.76",
    "json-schema-to-zod": "2.8.1",
    "hono": "4.12.27",
    "@hono/node-server": "2.0.8",
    "uuid": "13.0.0",
    "@picteus/internal-extension-sdk": "0.13.1"
  }
}
