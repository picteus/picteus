{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v2.schema.json",
  "id": "midjourney",
  "version": "1.2.0",
  "name": "Midjourney",
  "description": "Accesses to all sorts of Midjourney features.",
  "categories": ["capture"],
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "events": [
        "process.started",
        "process.runCommand",
        "image.created",
        "image.updated",
        "image.computeTags",
        "image.computeFeatures"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.created",
            "image.updated",
            "image.computeTags",
            "image.computeFeatures"
          ],
          "maximumCount": 8
        }
      ],
      "capabilities": [
        {
          "id": "image.tags"
        },
        {
          "id": "image.features"
        }
      ],
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/main.js"
        ]
      },
      "commands": []
    }
  ],
  "ui": {
    "elements": [
      {
        "id": "main",
        "integration": {
          "anchor": "sidebar",
          "isExternal": true
        },
        "url": "https://www.midjourney.com"
      }
    ]
  },
  "settings": {
    "type": "object"
  }
}
