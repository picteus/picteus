{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v2.schema.json",
  "id": "bria",
  "version": "0.4.0",
  "name": "Bria",
  "description": "Removes background from images.",
  "categories": [
    "utility"
  ],
  "runtimes": [
    {
      "environment": "python"
    }
  ],
  "instructions": [
    {
      "events": [
        "process.started",
        "image.runCommand"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.runCommand"
          ],
          "maximumCount": 1
        }
      ],
      "execution": {
        "executable": "${venvPython}",
        "arguments": [
          "./main.py"
        ]
      },
      "commands": [
        {
          "id": "removeBackground",
          "on": {
            "entity": "Images"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Remove background",
              "name": "Remove image background",
              "description": "Removes the background from images via the Bria model."
            }
          ]
        }
      ]
    }
  ],
  "settings": {
    "type": "object"
  }
}
