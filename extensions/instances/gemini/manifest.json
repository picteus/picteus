{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v6.schema.json",
  "id": "gemini",
  "version": "1.9.0",
  "name": "Google Gemini",
  "description": "Generate and modify images using Google Gemini AI, and compute image captions and eligible tags for enhanced image organization.",
  "categories": [
    "capture",
    "generation",
    "enrichment"
  ],
  "author": "KoppaSoft",
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "events": [
        "process.started",
        "process.runCommand",
        "image.created",
        "image.updated",
        "image.computeFeatures",
        "image.computeTags",
        "image.runCommand"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.created",
            "image.updated",
            "image.computeFeatures",
            "image.computeTags"
          ],
          "maximumCount": 4
        }
      ],
      "capabilities": [
        {
          "id": "image.features",
          "details": {
            "caption": true
          }
        },
        {
          "id": "image.tags",
          "details": {
            "eligibleTags": true
          }
        }
      ],
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/main.js"
        ]
      },
      "commands": [
        {
          "id": "generate",
          "on": {
            "entity": "Process"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "title": "Model",
                "description": "The Gemini image-generation model to use.",
                "enum": [
                  "gemini-3-pro-image-preview",
                  "gemini-2.5-flash-image",
                  "gemini-nano-banana-2.1"
                ],
                "default": "gemini-3-pro-image-preview",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "aspectRatio": {
                "type": "string",
                "title": "Aspect ratio",
                "description": "The aspect ratio of the generated image.",
                "enum": [
                  "1:1",
                  "2:3",
                  "3:2",
                  "3:4",
                  "4:3",
                  "4:5",
                  "5:4",
                  "9:16",
                  "16:9",
                  "21:9"
                ],
                "default": "1:1",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "prompt": {
                "type": "string",
                "title": "Prompt",
                "description": "Describe the image to generate.",
                "default": "a cat eating a nano-banana in a fancy restaurant under the Gemini constellation",
                "ui": {
                  "widget": "textarea"
                }
              }
            },
            "required": [
              "model",
              "aspectRatio",
              "prompt"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Generate image",
              "name": "Generate an image from text",
              "description": "Generates an image from a text prompt with the selected Gemini image model and aspect ratio, saves it with generation metadata in the extension repository, and displays the result."
            }
          ]
        },
        {
          "id": "modify",
          "on": {
            "entity": "Images"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "title": "Model",
                "description": "The Gemini image-generation model to use.",
                "enum": [
                  "gemini-3-pro-image-preview",
                  "gemini-2.5-flash-image",
                  "gemini-nano-banana-2.1"
                ],
                "default": "gemini-3-pro-image-preview",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "aspectRatio": {
                "type": "string",
                "title": "Aspect ratio",
                "description": "The aspect ratio of the generated image.",
                "enum": [
                  "1:1",
                  "2:3",
                  "3:2",
                  "3:4",
                  "4:3",
                  "4:5",
                  "5:4",
                  "9:16",
                  "16:9",
                  "21:9"
                ],
                "default": "1:1",
                "ui": {
                  "widget": "radio",
                  "inline": true
                }
              },
              "prompt": {
                "type": "string",
                "title": "Prompt",
                "description": "Describe the image to generate. The selected images are sent to Gemini as visual references.",
                "default": "a cat eating a nano-banana in a fancy restaurant under the Gemini constellation",
                "ui": {
                  "widget": "textarea"
                }
              }
            },
            "required": [
              "model",
              "aspectRatio",
              "prompt"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Modify images",
              "name": "Generate an image using selected images",
              "description": "Uses the selected images as visual references and generates an image from your prompt with the selected Gemini image model and aspect ratio. Saves the result with generation metadata in the extension repository and displays it."
            }
          ]
        }
      ]
    }
  ],
  "ui": {
    "elements": [
      {
        "id": "main",
        "integration": {
          "anchor": "sidebar",
          "isExternal": true
        },
        "url": "https://gemini.google.com"
      }
    ]
  },
  "settings": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "title": "Google Gemini API Key",
        "description": "Required Gemini API key used for image generation, image modification, captions, and eligible-tag computation.",
        "ui": {
          "widget": "password"
        }
      },
      "maximumTokens": {
        "type": "integer",
        "title": "Maximum tokens",
        "description": "Maximum output tokens for caption and eligible-tag responses. Does not limit image generation.",
        "default": 2048,
        "minimum": 256,
        "maximum": 16384,
        "ui": {
          "widget": "range"
        }
      }
    },
    "required": [
      "apiKey",
      "maximumTokens"
    ]
  }
}
