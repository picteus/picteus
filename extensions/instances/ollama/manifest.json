{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v2.schema.json",
  "id": "ollama",
  "version": "0.4.1",
  "name": "Ollama",
  "description": "Computes the caption features of an image through Vision Languages (VL) through Ollama.",
  "categories": ["enrichment", "integration"],
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/main.js"
        ]
      },
      "events": [
        "process.started",
        "image.created",
        "image.updated",
        "image.computeFeatures",
        "image.computeTags",
        "image.runCommand"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.created",
            "image.updated",
            "image.computeFeatures",
            "image.computeTags",
            "image.runCommand"
          ],
          "durationInMilliseconds": 200,
          "maximumCount": 2
        }
      ],
      "capabilities": [
        {
          "id": "image.features"
        },
        {
          "id": "image.tags"
        }
      ],
      "commands": [
        {
          "id": "askQuestion",
          "on": {
            "entity": "Image"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "title": "Model",
                "description": "The Vision Languages (VL) model to use for answering the question.",
                "enum": [
                  "llava",
                  "qwen2.5vl",
                  "minicpm-v",
                  "granite3.2-vision",
                  "gemma3",
                  "mistral-small3.2",
                  "moondream",
                  "bakllava",
                  "llava-phi3"
                ],
                "default": "llava"
              },
              "question": {
                "type": "string",
                "title": "Question?",
                "description": "The question you want the Vision Language model to answer, for the selected image",
                "default": "What are the dominant colors?",
                "ui": {
                  "widget": "textarea"
                }
              }
            },
            "required": [
              "model",
              "question"
            ]
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Ask question",
              "description": "Proposes to ask question to a Vision Language model."
            }
          ]
        }
      ]
    }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "ollamaUrl": {
        "type": "string",
        "format": "uri",
        "title": "Ollama URL",
        "description": "The URL of the Ollama server which is running on the same computer.",
        "default": "http://127.0.0.1:11434"
      },
      "caption": {
        "type": "object",
        "title": "Caption",
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "Whether auto-captioning is enabled.",
            "default": true
          },
          "models": {
            "type": "array",
            "title": "Models",
            "description": "The Vision Languages (VL) models to use for computing the image features.",
            "items": {
              "type": "string",
              "description": "A Vision Language model.",
              "enum": [
                "llava",
                "llava-llama3",
                "llava-phi3",
                "bakllava",
                "qwen3-vl",
                "qwen2.5vl",
                "llama3.2-vision",
                "minicpm-v",
                "granite3.2-vision",
                "gemma3",
                "mistral-small3.2",
                "moondream",
                "nemotron3"
              ],
              "default": "llava"
            },
            "default": [
              "llava"
            ]
          },
          "questions": {
            "type": "array",
            "title": "Questions",
            "description": "The questions which will be used to request the VL models",
            "items": {
              "type": "string",
              "description": "A question that will be asked to the VL model to compute the image caption."
            },
            "default": [
              "Describe in details through nominal or noun sentences the image. Your sentences should not mention the fact that the image was provided, and you should not start your sentences with \"the image is\" or \"the image displays\" or the \"the image shows\"."
            ]
          }
        },
        "required": [
          "enabled",
          "models",
          "questions"
        ]
      },
      "tags": {
        "type": "object",
        "title": "Tags",
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "Whether auto-tagging is enabled.",
            "default": true
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "The Vision Languages (VL) model to use for computing the tags.",
            "enum": [
              "llava",
              "llava-llama3",
              "llava-phi3",
              "bakllava",
              "qwen3-vl",
              "qwen2.5vl",
              "llama3.2-vision",
              "minicpm-v",
              "granite3.2-vision",
              "gemma3",
              "mistral-small3.2",
              "moondream",
              "nemotron3"
            ],
            "default": "llava"
          },
          "tags": {
            "type": "array",
            "title": "Tags",
            "description": "The tags to pick from when tagging the image, spaces are not allowed.",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9A-Z-_.]{1,64}$",
              "minLength": 1,
              "maxLength": 64
            },
            "default": [
              "animal",
              "insect",
              "mammal",
              "vegetal",
              "mineral",
              "architecture",
              "food",
              "landscape",
              "portrait",
              "vehicle",
              "art",
              "fashion"
            ]
          },
          "question": {
            "type": "string",
            "title": "Question template",
            "description": "The question template to use for requesting the tags from the VL model. It should contain the '{tags}' string, which will be replaced by the provided tags.",
            "default": "Pick the tags that best fit the image from this list: {tags}."
          }
        },
        "required": [
          "enabled",
          "model",
          "question"
        ]
      }
    },
    "required": [
      "ollamaUrl",
      "caption",
      "tags"
    ]
  }
}
