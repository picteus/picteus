{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v3.schema.json",
  "id": "ollama",
  "version": "0.8.0",
  "name": "Ollama",
  "description": "Computes facets of an image through Vision Languages (VL) through Ollama.",
  "categories": [
    "enrichment",
    "integration"
  ],
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/main.js"
        ]
      },
      "events": [
        "process.started",
        "image.computeFeatures",
        "image.computeTags"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.computeFeatures",
            "image.computeTags"
          ],
          "durationInMilliseconds": 1000,
          "maximumCount": 1
        }
      ],
      "capabilities": [
        {
          "id": "image.features",
          "details": {
            "caption": true
          }
        },
        {
          "id": "image.tags",
          "details": {
            "eligibleTags": true
          }
        }
      ]
    }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "ollamaUrl": {
        "type": "string",
        "format": "uri",
        "title": "Ollama URL",
        "description": "The URL of the Ollama server which is running on the same computer.",
        "default": "http://127.0.0.1:11434"
      }
    },
    "required": [
      "ollamaUrl"
    ]
  }
}
