{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v5.schema.json",
  "id": "embeddings",
  "version": "0.9.0",
  "name": "Embeddings",
  "description": "Computes the embeddings of an image.",
  "categories": [
    "enrichment"
  ],
  "runtimes": [
    {
      "environment": "python"
    }
  ],
  "instructions": [
    {
      "events": [
        "process.started",
        "image.computeEmbeddings",
        "text.computeEmbeddings"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.computeEmbeddings",
            "text.computeEmbeddings"
          ],
          "durationInMilliseconds": 250,
          "maximumCount": 4
        }
      ],
      "capabilities": [
        {
          "id": "image.embeddings"
        },
        {
          "id": "text.embeddings"
        }
      ],
      "commands": [],
      "execution": {
        "executable": "${venvPython}",
        "arguments": [
          "./main.py"
        ]
      }
    }
  ],
  "settings": {
  }
}
