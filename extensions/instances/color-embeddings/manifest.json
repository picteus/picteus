{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v2.schema.json",
  "id": "color-embeddings",
  "version": "0.4.0",
  "name": "Color Embeddings",
  "description": "Compute embedding of the image dominant colors.",
  "categories": [
    "enrichment"
  ],
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "events": [
        "process.started",
        "image.created",
        "image.updated",
        "image.deleted",
        "image.computeEmbeddings",
        "image.computeFeatures"
      ],
      "throttlingPolicies": [
        {
          "events": [
            "image.created",
            "image.updated",
            "image.computeEmbeddings",
            "image.computeFeatures"
          ],
          "durationInMilliseconds": 100,
          "maximumCount": 10
        }
      ],
      "capabilities": [
        {
          "id": "image.embeddings"
        },
        {
          "id": "image.features"
        }
      ],
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/main.js"
        ]
      },
      "commands": []
    }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "colorLibrary": {
        "type": "string",
        "enum": [
          "color-thief"
        ],
        "title": "Extraction Library",
        "description": "Which library to use to extract the dominant colors of an image.",
        "default": "color-thief"
      },
      "colorCount": {
        "type": "integer",
        "minimum": 2,
        "maximum": 20,
        "title": "Dominant Colors",
        "description": "How many dominant colors to extract from each image.",
        "default": 8
      }
    },
    "required": [
      "colorLibrary",
      "colorCount"
    ]
  }
}
