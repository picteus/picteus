{
  "$schema": "https://picteus.github.io/picteus/jsonschema/manifest-v2.schema.json",
  "id": "c2pa",
  "version": "1.2.0",
  "name": "C2PA",
  "description": "Reveals the Content Authenticity Initiative metadata.",
  "categories": ["enrichment"],
  "runtimes": [
    {
      "environment": "node"
    }
  ],
  "instructions": [
    {
      "events": [
        "process.started",
        "image.runCommand"
      ],
      "execution": {
        "executable": "${node}",
        "arguments": [
          "./dist/main.js"
        ]
      },
      "commands": [
        {
          "id": "readMetadata",
          "on": {
            "entity": "Images"
          },
          "specifications": [
            {
              "locale": "en",
              "label": "Read the C2PA metadata",
              "description": "Given images, it scans them against the C2PA database and subsequently update their metadata by attaching the JSON content retrieved and their attached thumbnails."
            }
          ]
        }
      ]
    }
  ],
  "settings": {
    "type": "object"
  }
}
