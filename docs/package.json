{
  "name": "@picteus/docs",
  "version": "0.1.0",
  "productName": "Picteus Documentation",
  "description": "The documentation of the application.",
  "keywords": [
    "picture",
    "image",
    "lens",
    "voyager",
    "explorer",
    "search",
    "Odysseus"
  ],
  "author": {
    "name": "Édouard Mercier",
    "email": "edouard@koppasoft.com",
    "url": "https://github.com/edouardmercier"
  },
  "license": "GNU Affero General Public License",
  "private": false,
  "engines": {
    "node": ">=22.17.1"
  },
  "homepage": "https://github.com/picteus/picteus",
  "repository": {
    "type": "git",
    "url": "https://github.com/picteus/picteus.git"
  },
  "bugs": {
    "url": "https://github.com/picteus/Picteus/issues"
  },
  "scripts": {
    "reset": "npm run clean && shx rm -rf node_modules docs/manual/webservicesapi/reference",
    "clean": "docusaurus clear",
    "docusaurus": "docusaurus",
    "gen-api-docs": "docusaurus gen-api-docs all",
    "start": "npm run gen-api-docs && docusaurus start",
    "build:github": "npm run gen-api-docs && docusaurus build",
    "build:local": "npm run gen-api-docs && cross-env DOCUSAURUS_BASE_URL=/ docusaurus build",
    "build": "npm run build:github",
    "swizzle": "docusaurus swizzle",
    "deploy": "npm run gen-api-docs && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "npm run gen-api-docs && docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "npm run gen-api-docs && tsc"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "devDependencies": {
    "shx": "0.4.0",
    "cross-env": "10.0.0",
    "typescript": "5.9.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "docusaurus-plugin-llms": "0.6.1",
    "docusaurus-plugin-openapi-docs": "5.2.0",
    "docusaurus-plugin-sass": "0.2.7",
    "sass": "1.108.0"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "docusaurus-theme-openapi-docs": "5.2.0"
  }
}
